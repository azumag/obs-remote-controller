# Keep the HTTP gateway on loopback when using Tailscale Serve.
HOST=127.0.0.1
PORT=8787

# Run `npm run setup` to generate this automatically.
REMOTE_CONTROL_TOKEN=replace-with-a-long-random-token

# OBS Studio > Tools > WebSocket Server Settings
OBS_WEBSOCKET_URL=ws://127.0.0.1:4455
OBS_WEBSOCKET_PASSWORD=replace-with-your-obs-websocket-password
OBS_RECONNECT_INTERVAL_MS=3000

# HTTPS port exposed privately by Tailscale Serve.
TAILSCALE_HTTPS_PORT=8443
